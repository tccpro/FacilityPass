# FacilityPass - environment configuration template
#
# Copy to .env.local and edit. .env.local is git-ignored and must never be
# committed.
#
#   PowerShell:  Copy-Item .env.example .env.local
#   cmd:         copy .env.example .env.local
#
# Every variable below is validated in src/server/env.ts (added in
# phase/00-foundation-core). This file is committed - NEVER put a real secret
# in it.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PHASE 0: OPTIONAL. The application runs, builds, tests and deploys without a
#          database; /api/health reports it honestly as not configured.
# PHASE 1: REQUIRED.
#
# Must start with postgres:// or postgresql://. An empty value is treated as
# absent rather than malformed, but leaving the line commented out is
# unambiguous.
#
# DATABASE_URL="postgresql://user:password@host.eu-central-1.aws.neon.tech/facilitypass?sslmode=require"

# ---------------------------------------------------------------------------
# Client
# Inlined into the browser bundle at build time - never put secrets here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
